# Production Environment Variables
# Copy this file to .env.production.local and fill in the values

# App
NEXT_PUBLIC_APP_URL=https://drivee.briga.id
NEXT_PUBLIC_APP_NAME=Drivee

# CORS
ALLOWED_ORIGINS=https://drivee.briga.id

# OSRM
OSRM_URL=https://router.project-osrm.org

# API
API_SECRET_KEY=your-production-secret-key
API_RATE_LIMIT=100

# Database (if using PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/briga

# Cloudflare (if using Workers)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id
