# ─────────────────────────────────────────────────────────────
# Drifee by Briga — Environment Variables
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=https://drifee.briga.id
NEXT_PUBLIC_APP_NAME=Drifee

# CORS (hanya domain PWA kita)
ALLOWED_ORIGINS=https://drifee.briga.id

# OSRM Routing Server
OSRM_URL=https://router.project-osrm.org

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
NEXTAUTH_URL=https://drifee.briga.id
NEXTAUTH_SECRET=your-random-secret-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Baileys Multi-Agent
BAILEYS_CONFIG_PATH=./baileys-config.json
BAILEYS_SESSION_BASE_PATH=./sessions
BAILEYS_HEALTH_CHECK_INTERVAL=30000
BAILEYS_AUTO_RECONNECT=true
BAILEYS_SESSION_BACKUP_INTERVAL=3600000

# SMTP (fallback email)
SMTP_HOST=xxx
SMTP_PORT=587
SMTP_USER=xxx
SMTP_PASS=xxx

# Unified BrigaCoin Integration (Server-to-Server)
BRIGA_SERVICE_KEY=your-briga-id-service-key
DRIFEE_SERVICE_KEY=your-drifee-service-key
WEBHOOK_SECRET=your-webhook-secret
BRIGA_WEBHOOK_URL=https://api.briga.id/webhooks/brigacoin
