# ─────────────────────────────────────────────────────────────
# Briga EV PWA — Environment Variables
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=https://drivee.briga.id
NEXT_PUBLIC_APP_NAME=Briga EV

# CORS (hanya domain PWA kita)
ALLOWED_ORIGINS=https://drivee.briga.id

# OSRM Routing Server
OSRM_URL=https://router.project-osrm.org

# API (jika nanti pakai backend terpisah)
API_SECRET_KEY=your-secret-key-here
API_RATE_LIMIT=100

# Database (jika nanti pakai PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/briga

# ─────────────────────────────────────────────────────────────
# Cloudflare (jika pakai Workers/Pages)
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id
