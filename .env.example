# ─────────────────────────────────────────────────────────────
# Drifee by Briga — Environment Variables
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=https://drifee.briga.id
NEXT_PUBLIC_APP_NAME=Drifee

# CORS (hanya domain PWA kita)
ALLOWED_ORIGINS=https://drifee.briga.id

# OSRM Routing Server
OSRM_URL=https://router.project-osrm.org

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
NEXTAUTH_URL=https://drifee.briga.id
NEXTAUTH_SECRET=your-random-secret-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy JWT secret (HS256) — fallback verifikasi sesi di middleware
# bila project Supabase belum memakai JWT Signing Keys asimetris (JWKS).
SUPABASE_JWT_SECRET=your-jwt-secret

# Baileys Multi-Agent
BAILEYS_CONFIG_PATH=./baileys-config.json
BAILEYS_SESSION_BASE_PATH=./sessions
BAILEYS_HEALTH_CHECK_INTERVAL=30000
BAILEYS_AUTO_RECONNECT=true
BAILEYS_SESSION_BACKUP_INTERVAL=3600000

# Email Dispatcher (Resend API / SMTP)
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=Drifee by Briga <no-reply@briga.id>
SMTP_HOST=xxx
SMTP_PORT=587
SMTP_USER=xxx
SMTP_PASS=xxx

# Lynk.id Payment Gateway Integration
NEXT_PUBLIC_LYNK_URL=https://lynk.id/drifee
LYNK_WEBHOOK_SECRET=your-lynk-webhook-secret
# (Opsional) Teruskan callback Lynk.id ke webhook Google Apps Script Brigawan yang lama
LYNK_FORWARD_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec?action=lynk_webhook

# Unified BrigaCoin Integration (Server-to-Server)
BRIGA_SERVICE_KEY=your-briga-id-service-key
DRIFEE_SERVICE_KEY=your-drifee-service-key
WEBHOOK_SECRET=your-webhook-secret
BRIGA_WEBHOOK_URL=https://api.briga.id/webhooks/brigacoin
